# Supabase credentials (get these from your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API key for proposal generation
OPENAI_API_KEY=your_openai_api_key
OPENAI_PROPOSAL_MODEL=gpt-4o-mini

# Protects POST /api/market-refresh for weekly cron/admin jobs
MARKET_REFRESH_SECRET=change_me_to_a_long_random_secret
