# Supabase credentials (get these from your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API key for proposal generation (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key
OPENAI_PROPOSAL_MODEL=gpt-4o-mini

# Google Gemini API configurations (Optional free-tier alternative to OpenAI)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Protects POST /api/market-refresh for weekly cron/admin jobs
MARKET_REFRESH_SECRET=change_me_to_a_long_random_secret
